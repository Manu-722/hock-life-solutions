# Copy to .env and fill in

# Your Django backend's API root
VITE_API_BASE_URL=http://localhost:8000/api

# Firebase web app config - from Firebase Console -> Project Settings ->
# General -> "Your apps" -> Web app -> SDK setup and configuration.
# This is the SAME Firebase project as the backend's service account key.
# These values are safe to expose in frontend code (they're not secrets -
# Firebase's security comes from its server-side rules, not from hiding
# these IDs), but keep them in .env for easy configuration per environment.
VITE_FIREBASE_API_KEY=REPLACE_WITH_YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=REPLACE_WITH_YOUR_FIREBASE_APP_ID
