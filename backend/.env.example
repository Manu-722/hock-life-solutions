# Copy this file to `.env` and fill in real values before deploying.
# None of the values below are real credentials - they are placeholders
# for you to replace with your own.

DJANGO_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_STRING
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Postgres (leave blank to keep using SQLite while developing locally)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=hocklife
DB_USER=REPLACE_WITH_YOUR_DB_USER
DB_PASSWORD=REPLACE_WITH_YOUR_DB_PASSWORD
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com

# Email (for the 5-minute password reset code). Gmail example uses an "app password".
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=REPLACE_WITH_YOUR_EMAIL_ADDRESS
EMAIL_HOST_PASSWORD=REPLACE_WITH_YOUR_EMAIL_APP_PASSWORD
DEFAULT_FROM_EMAIL=Hawk Life Solutions <no-reply@hawklife.com>

# Google login - create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=REPLACE_WITH_YOUR_GOOGLE_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=REPLACE_WITH_YOUR_GOOGLE_CLIENT_SECRET

# Hawk Life Solutions M-Pesa Paybill payment details shown at checkout
# (these are public payment details, not secrets - safe to keep here)
COMPANY_PAYBILL_NUMBER=522522
COMPANY_ACCOUNT_NUMBER=7518213

# One-time starter password for the first admin account (created via
# `python manage.py create_admin`). Pick your own strong value here -
# the admin is forced to change it the moment they log in.
ADMIN_STARTER_PASSWORD=REPLACE_WITH_YOUR_OWN_STRONG_PASSWORD